<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>aimmod-osu-worker</AssemblyName>
    <Description>Headless worker implementation for AimMod's selected osu runtime code.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AimMod.Osu.Runtime/AimMod.Osu.Runtime.csproj" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Taiko" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Catch" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Mania" Version="2026.916.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ppy.osu.Game" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Osu" Version="2026.916.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Patched versions of packages ppy.osu.Game depends on, for published security advisories. Remove each
         once ppy.osu.Game references a fixed version itself. -->
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Common" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.13" />
  </ItemGroup>
</Project>
