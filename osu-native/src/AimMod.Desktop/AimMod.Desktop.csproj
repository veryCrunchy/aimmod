<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AimMod</AssemblyName>
    <StartupObject>AimMod.Desktop.Program</StartupObject>
    <Description>Native AimMod desktop shell.</Description>
    <ApplicationIcon>Resources/Brand/aimmod.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageReference Include="OsuParsers" Version="1.7.2" />
    <PackageReference Include="ppy.osu.Game" Version="2026.730.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Osu" Version="2026.730.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Taiko" Version="2026.730.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Catch" Version="2026.730.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Mania" Version="2026.730.0" />

    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AimMod.Osu.Runtime/AimMod.Osu.Runtime.csproj" />
    <ProjectReference Include="../AimMod.Osu.Worker/AimMod.Osu.Worker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/Audio/*.ogg" LogicalName="AimMod.Resources.Audio.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources/Audio/*.wav" LogicalName="AimMod.Resources.Audio.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources/Skins/creator-releases.json" LogicalName="AimMod.Resources.Skins.creator-releases.json" />
    <EmbeddedResource Include="Resources/Brand/*.png" LogicalName="AimMod.Resources.Brand.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources/Brand/aimmod.ico" LogicalName="AimMod.Resources.Brand.aimmod.ico" />
  </ItemGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))">
    <Content Include="Resources/Brand/linux/hicolor/**/*.png" TargetPath="share/icons/hicolor/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
