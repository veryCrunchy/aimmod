<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Release builds pass the version (CI: AimModVersion=<semver>). -->
    <Version Condition="'$(AimModVersion)' != ''">$(AimModVersion)</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="../ui/index.html" LogicalName="AimMod.UI" />
    <EmbeddedResource Include="../ui/statistics.js" LogicalName="AimMod.StatisticsScript" />
    <EmbeddedResource Include="../ui/statistics.css" LogicalName="AimMod.StatisticsStyle" />
    <EmbeddedResource Include="../ui/run-details.js" LogicalName="AimMod.RunDetailsScript" />
    <EmbeddedResource Include="../ui/run-details.css" LogicalName="AimMod.RunDetailsStyle" />
    <EmbeddedResource Include="../ui/settings.js" LogicalName="AimMod.SettingsScript" />
    <EmbeddedResource Include="../ui/coaching.js" LogicalName="AimMod.CoachingScript" />
    <EmbeddedResource Include="../ui/coaching.css" LogicalName="AimMod.CoachingStyle" />
    <EmbeddedResource Include="../ui/workspace-theme.css" LogicalName="AimMod.WorkspaceTheme" />
    <EmbeddedResource Include="../ui/mechanics.js" LogicalName="AimMod.MechanicsScript" />
    <EmbeddedResource Include="../ui/benchmarks.js" LogicalName="AimMod.BenchmarksScript" />
    <EmbeddedResource Include="../ui/benchmarks.css" LogicalName="AimMod.BenchmarksStyle" />
    <EmbeddedResource Include="../ui/leaderboard.js" LogicalName="AimMod.LeaderboardScript" />
    <EmbeddedResource Include="../ui/leaderboard.css" LogicalName="AimMod.LeaderboardStyle" />
    <EmbeddedResource Include="../ui/overlay.html" LogicalName="AimMod.OverlayHtml" />
    <EmbeddedResource Include="../ui/overlay.js" LogicalName="AimMod.OverlayScript" />
    <EmbeddedResource Include="../ui/overlay.css" LogicalName="AimMod.OverlayStyle" />
    <EmbeddedResource Include="../ui/overlay-editor.js" LogicalName="AimMod.OverlayEditor" />
    <EmbeddedResource Include="../ui/overlay-editor.css" LogicalName="AimMod.OverlayEditorStyle" />
    <EmbeddedResource Include="../ue4ss/AimModNativeUI/Assets/aimmod-horizontal.png" LogicalName="AimMod.Logo" />
    <EmbeddedResource Include="../replay/browser.js" LogicalName="AimMod.ReplayBrowser" />
    <EmbeddedResource Include="../replay/native-browser.js" LogicalName="AimMod.NativeReplayBrowser" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="../ui/history-import.js" LogicalName="AimMod.HistoryImport" /></ItemGroup>
  <!-- Mode icons (tools/mode-icons/build.cjs): AimMod.ModeIcon.<id>[-on]@<n>x.png -->
  <ItemGroup><EmbeddedResource Include="../ui/art/modes/png/*.png" LogicalName="AimMod.ModeIcon.%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../ui/tournaments.js" LogicalName="AimMod.TournamentsScript" /><EmbeddedResource Include="../ui/tournaments.css" LogicalName="AimMod.TournamentsStyle" /><EmbeddedResource Include="../ui/tournament-overlay.html" LogicalName="AimMod.TournamentOverlayHtml" /><EmbeddedResource Include="../ui/tournament-overlay.js" LogicalName="AimMod.TournamentOverlayScript" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../ui/lifecycle.js" LogicalName="AimMod.LifecycleScript" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="../ui/discord-settings.js" LogicalName="AimMod.DiscordSettingsScript" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../ui/hub-sharing.js" LogicalName="AimMod.HubSharingScript" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../ui/multiplayer.js" LogicalName="AimMod.MultiplayerScript" /><EmbeddedResource Include="../ui/multiplayer.css" LogicalName="AimMod.MultiplayerStyle" /><EmbeddedResource Include="../ui/notify.html" LogicalName="AimMod.NotifyPage" /><EmbeddedResource Include="../ui/notify.js" LogicalName="AimMod.NotifyScript" /><EmbeddedResource Include="../ui/notify.css" LogicalName="AimMod.NotifyStyle" /><EmbeddedResource Include="../ui/developer.js" LogicalName="AimMod.DeveloperScript" /><EmbeddedResource Include="../ui/standings.js" LogicalName="AimMod.StandingsScript" /><EmbeddedResource Include="../ui/cshud.js" LogicalName="AimMod.CsHudScript" /><EmbeddedResource Include="../ui/cshud.css" LogicalName="AimMod.CsHudStyle" /><EmbeddedResource Include="../ui/worldtags.js" LogicalName="AimMod.WorldTagsScript" /><EmbeddedResource Include="../ui/worldtags.css" LogicalName="AimMod.WorldTagsStyle" /><EmbeddedResource Include="../ui/standings.css" LogicalName="AimMod.StandingsStyle" /><EmbeddedResource Include="../ui/board.html" LogicalName="AimMod.BoardHtml" /><EmbeddedResource Include="../ui/board.js" LogicalName="AimMod.BoardScript" /><EmbeddedResource Include="../ui/developer.css" LogicalName="AimMod.DeveloperStyle" /></ItemGroup>
</Project>
