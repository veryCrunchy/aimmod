<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks for AimMod-Setup.exe: dotnet run -c Release (in this folder)
       Synthetic feeds, packages and game folders under %TEMP%; nothing touches the
       real game, the network or the real Apps & features entry. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AimMod.Setup.Checks</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF projects leave these out of the implicit usings. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <ProjectReference Include="../app/AimMod.Setup.csproj" />
    <ProjectReference Include="../../install-core/AimMod.Install.csproj" />
  </ItemGroup>
</Project>
